    "dirs": [
     ".chilly/jobs/a",
     ".chilly/output"
    ],
    "files": {
     ".chilly/answers.jsonl": "A",
     ".chilly/jobs/a/report.md": "R",
     ".chilly/.hidden": "H"
    }
   },
   "kind": "renamed",
   "notice": true,
   "exist": [
    ".benji/answers.jsonl",
    ".benji/jobs/a/report.md",
    ".benji/.hidden",
    ".benji/output",
    ".benji/benji_migrated_from"
   ],
   "absent": [
    ".chilly"
   ],
   "marker": "renamed",
