# Copy this to ~/.benji.env and fill in your keys. (Benji reads it from your home folder only.)
#   cp .benji.env.example ~/.benji.env  &&  chmod 600 ~/.benji.env
# Benji loads these automatically. Real environment variables always take precedence.
# NEVER commit your real ~/.benji.env — it holds secrets.

# One model key (pick the provider you use):
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Open-model providers: set BENJI_PROVIDER to choose one, and its key. A hosted provider receives
# your messages, tool results and (with Screen on) screenshots; the README says where each one is.
# BENJI_PROVIDER=deepseek     # deepseek | glm | kimi | qwen | ollama | lmstudio
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=                 # GLM (Z.ai); BENJI_REGION=cn uses Zhipu's open.bigmodel.cn, with its own key
# MOONSHOT_API_KEY=            # Kimi
# DASHSCOPE_API_KEY=           # Qwen (Alibaba Cloud Model Studio); keys are per region
# BENJI_REGION=intl           # intl (default) or cn, for glm, kimi and qwen
# BENJI_THINKING=off          # off (default) | on | default: the model's own thinking
# BENJI_VISION=               # 1 or 0 overrides Benji's table of which models read images (Screen)
# BENJI_MAX_TOKENS=           # output limit sent to these providers (default 8192; 16000 for Kimi)
# Local models need no key; name the one you have loaded:
#   BENJI_PROVIDER=ollama   BENJI_MODEL=llama3.2
#   BENJI_PROVIDER=lmstudio BENJI_MODEL=<the model id in LM Studio's server tab>

# Optional: reliable web search (otherwise Benji falls back to DuckDuckGo).
# BRAVE_API_KEY=
# SERPAPI_KEY=

# Optional: voice input transcription (OpenAI Whisper or Deepgram).
# OPENAI_API_KEY=        # also used for Whisper
# DEEPGRAM_API_KEY=

# Optional overrides:
# BENJI_PROVIDER=claude
# BENJI_MODEL=claude-sonnet-5-5   # default claude-haiku-5-5; Sonnet 5.5 draws better figures, ~12x the cost
# BENJI_EFFORT=low                  # low (default), medium, high, xhigh, max
# BENJI_WORKDIR=~/.benji
