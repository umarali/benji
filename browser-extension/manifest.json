{
  "manifest_version": 3,
  "name": "Benji",
  "version": "0.2.1",
  "description": "Lets Benji's background jobs read, and with your approval click and type on, pages you approved, in a tab group called Benji.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "tabGroups", "scripting", "storage", "alarms", "debugger"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Benji", "default_popup": "popup.html" }
}
